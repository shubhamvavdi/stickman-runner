{
  "name": "@gamehubsdk/gamehub-ad-sdk",
  "version": "1.0.1",
  "description": "GameHub advertising SDK for web games: banner, interstitial and rewarded ads via a GameHub-compatible ad API.",
  "main": "./dist/gamehub-sdk.umd.cjs",
  "module": "./dist/gamehub-sdk.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/gamehub-sdk.es.js",
      "require": "./dist/gamehub-sdk.umd.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": ["gamehub", "ads", "sdk", "web-games", "banner", "interstitial", "rewarded"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
